# CineHub Environment Configuration Blueprint
# DO NOT COMMIT SECRETS OR PASSWORDS TO SOURCE CONTROL

# PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinehub?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_SECRET="cinehub-super-secret-jwt-key-minimum-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# Cinema Business Rules & Taxes (India Specific)
GST_RATE_PERCENT="18"
CONVENIENCE_FEE_INR="30"
SEAT_HOLD_DURATION_MINUTES="10"
CANCELLATION_DEADLINE_HOURS="2"
